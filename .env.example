# =============================================================================
# 66degrees Content Marketing — environment template
# Copy to .env and fill in values. Never commit real secrets.
# =============================================================================

# --- Runtime ---
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=./data
REFERENCES_DB_PATH=./references/references.db

# --- LLM providers ---
# Use "mock" for offline / CI / agent tests (no paid API calls).
# Valid: mock | anthropic | openai | gemini
LLM_PROVIDER=mock

# Anthropic (optional unless LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (optional unless LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Google / Gemini (optional unless LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- MCP auth (required for remote / HTTP transports) ---
# Local stdio Claude Desktop does not require these.
MCP_AUTH_TOKEN=
MCP_API_KEY=

# Comma-separated origins for remote MCP CORS (JSON list also accepted).
# Do not use "*" in production remote mode.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000

# --- Optional integrations ---
# GitHub (reference refresh CI uses the Actions token; local refresh needs none)
# GITHUB_TOKEN=

# Content / reference sources are hard-coded allowlists in
# core/reference_library/source_fetcher.py — no secrets required for approved URLs.
